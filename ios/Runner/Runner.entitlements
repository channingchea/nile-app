<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- TEMPORARILY DISABLED: Associated Domains requires a paid Apple Developer
	     team; personal team builds fail with it present. RESTORE before shipping
	     Universal Links (once enrolled + APNs key in hand):
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:links.nile.app</string>
		<string>webcredentials:nile.app</string>
	</array>
	     webcredentials lets Apple Passwords share saved logins between the
	     website and the app; it needs a "webcredentials" section in the
	     apple-app-site-association file too. In-app save/fill works without it,
	     just scoped to the bundle ID.
	-->
	<!-- Push notifications (APNs). Without this key iOS never issues an APNs
	     device token, so FCM getToken() silently fails and no push arrives.
	     Codesigning flips "development" to "production" automatically in
	     App Store / TestFlight builds via the provisioning profile. -->
	<key>aps-environment</key>
	<string>development</string>
	<!-- Sign in with Apple (also enabled on the App ID in the developer portal). -->
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
	<!-- Shared container between the app and the Broadcast Upload Extension —
	     the screen-share frames travel over a socket in this group. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.nilestreaming.shared</string>
	</array>
</dict>
</plist>
