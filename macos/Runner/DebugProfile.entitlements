<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<key>com.apple.security.network.server</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.device.camera</key>
	<true/>
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<key>com.apple.security.files.user-selected.read-only</key>
	<true/>
	<!-- No com.apple.developer.aps-environment here either, and that is a
	     deliberate trade rather than an oversight. Debug signs automatically, so
	     adding push would make every `flutter run -d macos` depend on Xcode
	     being able to mint a Mac Development profile carrying the entitlement —
	     a new failure mode on the one build everyday development uses. Release
	     has it (and an embedded profile that authorises it), which is the build
	     push is verified against, exactly as on iOS. The cost is that a debug
	     run never gets an APNs token; PushService swallows that and retries,
	     so nothing else misbehaves. -->
	<!-- No com.apple.developer.applesignin here either: Debug could carry it,
	     but Release cannot (see Release.entitlements), so having it in Debug
	     would only let Sign in with Apple pass locally and fail once shipped. -->
</dict>
</plist>
